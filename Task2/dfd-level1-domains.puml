@startuml dfd-level1-domains
' Диаграмма потоков данных (DFD, уровень 1) — потоки между доменами «Будущее 2.0»
' Нотация: Data Flow Diagram. Процесс — овал, хранилище — цилиндр, внешняя сущность — прямоугольник.
' Цвет потока кодирует бизнес-сценарий (см. легенду).

title DFD уровень 1. Потоки данных между доменами «Будущее 2.0»

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowFontSize 10
skinparam linetype ortho

skinparam rectangle {
  BackgroundColor #ECEFF1
  BorderColor #546E7A
  FontColor #263238
}
skinparam usecase {
  FontColor #FFFFFF
  FontSize 12
}
skinparam database {
  BackgroundColor #2E7D32
  BorderColor #1B5E20
  FontColor #FFFFFF
}

' ===== Внешние сущности =====
rectangle "E1. Пациент / клиент" as E1
rectangle "E2. Бизнес-пользователь\nдомена" as E2
rectangle "E3. Регулятор" as E3
rectangle "E5. Партнёры:\nфарма, электроника" as E5

' ===== Ядровые домены =====
together {
  usecase "P1. Клиники\n(клиническая эксплуатация)" as P1 #1168BD
  usecase "P4. Финтех\n(банковские продукты)" as P4 #1168BD
}

usecase "P2. Медицинские данные\n(PHI, изолированный контур)" as P2 #AD1457
usecase "P2.1. Обезличивание\nи агрегация" as P21 #AD1457
usecase "P3. ИИ-сервисы\n(диагностика)" as P3 #AD1457

' ===== Поддерживающие домены =====
together {
  usecase "P5. Клиенты\n(мастер-данные, MDM)" as P5 #5C6BC0
  usecase "P6. Снабжение\nи инвентарь" as P6 #5C6BC0
  usecase "P7. Персонал\n(HR)" as P7 #5C6BC0
}

' ===== Домен-потребитель =====
usecase "P8. Головной офис\n(корпоративная отчётность)" as P8 #00838F

' ===== Будущие домены =====
together {
  usecase "P9. Фармацевтика\n(будущий домен)" as P9 #7E57C2
  usecase "P10. Электроника\nи устройства (будущий)" as P10 #7E57C2
}

' ===== Процессы платформы данных =====
usecase "P11. Приём и доставка\nсобытий (CDC + шина)" as P11 #37474F
usecase "P12. Публикация\nдата-продуктов" as P12 #37474F
usecase "P13. Каталогизация\nи governance" as P13 #37474F
usecase "P14. Обслуживание запросов\n(движок + портал)" as P14 #37474F
usecase "P15. Контроль доступа\nи аудит" as P15 #37474F

' ===== Хранилища =====
database "D1. Lakehouse:\nдата-продукты доменов" as D1
database "D2. Хранилище PHI\n(изолированное)" as D2 #AD1457
database "D3. Каталог\nметаданных" as D3
database "D4. Журнал\nаудита" as D4

' ===================================================================
' СЦ-1. Интеграция нового финтех-сервиса (синий)
E1 -[#1168BD]-> P4 : ДП-01. Заявки, платежи,\nзаявки на кредит
P4 -[#1168BD]-> P11 : ДП-02. События банковских\nпродуктов (CDC)
P11 -[#1168BD]-> P12 : ДП-03. Поток изменений\nв сыром слое
P12 -[#1168BD]-> D1 : ДП-04. Дата-продукт\n«Финансовые операции»
P4 -[#1168BD]-> P13 : ДП-05. Схема, контракт,\nвладелец, SLA
P5 -[#1168BD]-> P4 : ДП-06. Единый идентификатор\nклиента (MDM)

' ===================================================================
' СЦ-2. ИИ анализирует медданные (красный пунктир — регуляторный контур)
E1 -[#C62828,dashed]-> P1 : ДП-07. Обращение,\nсогласие на обработку
P1 -[#C62828,dashed]-> P2 : ДП-08. Медкарта, история болезни,\nрезультаты исследований
P2 -[#C62828,dashed]-> D2 : ДП-09. Хранение PHI\nв изолированном контуре
D2 -[#C62828,dashed]-> P3 : ДП-10. Чтение PHI только\nвнутри защищённого контура
P3 -[#C62828,dashed]-> P2 : ДП-11. Результат работы модели\n(в медкарту пациента)
P3 -[#C62828,dashed]-> P21 : ДП-12. Метрики качества\nи утилизации моделей
P2 -[#C62828,dashed]-> P21 : ДП-13. Обезличенные\nклинические агрегаты
P21 -[#C62828,dashed]-> P12 : ДП-14. Только агрегаты без PHI\n(шлюз обезличивания)

' ===================================================================
' СЦ-3. Подключение нового партнёра (фиолетовый)
E5 -[#6A1B9A]-> P9 : ДП-15. Поставки, номенклатура,\nпартии препаратов
E5 -[#6A1B9A]-> P10 : ДП-16. Телеметрия\nмедицинских устройств
P9 -[#6A1B9A]-> P11 : ДП-17. События домена\nчерез типовой коннектор
P10 -[#6A1B9A]-> P11 : ДП-18. События домена\nчерез типовой коннектор
P9 -[#6A1B9A]-> P13 : ДП-19. Регистрация\nдата-продукта в каталоге
P6 -[#6A1B9A]-> P11 : ДП-20. Остатки, потребность,\nдвижение запасов

' ===================================================================
' СЦ-4. Кросс-доменный отчёт головного офиса (зелёный)
P1 -[#2E7D32]-> P11 : ДП-21. Обезличенные операционные\nпоказатели клиник
P7 -[#2E7D32]-> P11 : ДП-22. Штат, нагрузка,\nфонд оплаты труда
P11 -[#2E7D32]-> P12 : ДП-23. Доставка событий\nвсех доменов
P12 -[#2E7D32]-> D1 : ДП-24. Публикация дата-продуктов\nв формате Iceberg
D1 -[#2E7D32]-> P8 : ДП-25. Чтение дата-продуктов\nсмежных доменов
P8 -[#2E7D32]-> D1 : ДП-26. Кросс-доменные витрины\nи сводные KPI
D1 -[#2E7D32]-> P14 : ДП-27. Данные для отчётов\nи ad-hoc-запросов
E2 -[#2E7D32]-> P14 : ДП-28. Запрос отчёта,\nсобственный срез
P14 -[#2E7D32]-> E2 : ДП-29. Готовый отчёт,\nдашборд, выгрузка

' ===================================================================
' Сквозные потоки платформы (governance, доступ, аудит)
P12 --> D3 : ДП-30. Технические метаданные\nи lineage
P13 --> D3 : ДП-31. Глоссарий, владельцы,\nклассификация PII/PHI
D3 --> P14 : ДП-32. Поиск дата-продуктов\nв портале
D3 --> P15 : ДП-33. Классификация данных\nдля правил доступа
P15 --> P14 : ДП-34. Маскирование,\nrow/column-level security
P14 --> D4 : ДП-35. Журнал обращений\nк данным
D4 --> E3 : ДП-36. Доказательная база\nдля регулятора
P15 --> D4 : ДП-37. Решения по доступу\nи их основания

legend right
  |= Обозначение |= Смысл |
  | Овал | Процесс (домен или процесс платформы) |
  | Цилиндр | Хранилище данных |
  | Прямоугольник | Внешняя сущность |
  | <color:#1168BD>——</color> | СЦ-1. Интеграция нового финтех-сервиса |
  | <color:#C62828>- -</color> | СЦ-2. ИИ анализирует медданные (контур PHI) |
  | <color:#6A1B9A>——</color> | СЦ-3. Подключение партнёра (фарма, электроника) |
  | <color:#2E7D32>——</color> | СЦ-4. Кросс-доменный отчёт головного офиса |
  | <color:#37474F>——</color> | Сквозные потоки: каталог, доступ, аудит |
  ---
  Цвет процесса: синий — ядровые домены, бордовый — контур PHI,
  индиго — поддерживающие, бирюзовый — потребитель,
  сиреневый — будущие домены, тёмно-серый — платформа.
  PHI покидает контур только через P2.1 (шлюз обезличивания).
endlegend

@enduml
