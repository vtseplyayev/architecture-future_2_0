@startuml dfd-level0-context
' Контекстная диаграмма потоков данных (DFD, уровень 0) — «Будущее 2.0»
' Нотация: Data Flow Diagram. Процесс — овал, внешняя сущность — прямоугольник.

title DFD уровень 0 (контекст). Экосистема «Будущее 2.0»: внешние источники и приёмники данных

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowFontSize 11
skinparam rectangle {
  BackgroundColor #ECEFF1
  BorderColor #546E7A
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #1168BD
  BorderColor #0B4884
  FontColor #FFFFFF
  FontSize 14
}

' ===== Внешние сущности =====
rectangle "E1. Пациент / клиент" as E1
rectangle "E2. Сотрудник домена\n(бизнес-пользователь)" as E2
rectangle "E3. Регулятор\n(Роскомнадзор, ЦБ РФ)" as E3
rectangle "E4. Внешние финансовые системы\n(платёжные системы, ЦБ РФ)" as E4
rectangle "E5. Партнёры\n(фарма, производитель электроники)" as E5
rectangle "E6. Поставщики и производители\nмедицинского оборудования" as E6

' ===== Единственный процесс уровня 0 =====
usecase "0.\nЭкосистема «Будущее 2.0»\n(домены + платформа данных)" as P0

' ===== Потоки =====
E1 --> P0 : Обращения, согласия на обработку ПДн,\nплатежи и заявки на кредит
P0 --> E1 : Результаты приёма, счета,\nстатусы банковских продуктов

E2 --> P0 : Запрос отчёта и среза данных,\nзапрос доступа к дата-продукту
P0 --> E2 : Отчёт, дашборд, метрики качества\nи SLA дата-продукта

P0 --> E3 : Регуляторная отчётность,\nжурнал доступа к ПДн и медданным
E3 --> P0 : Требования и запросы\nна раскрытие информации

E4 <--> P0 : Платёжные транзакции,\nставки и справочники

E5 --> P0 : Данные партнёрских направлений\n(поставки, номенклатура, телеметрия устройств)
P0 --> E5 : Согласованные показатели\nсовместных направлений

E6 --> P0 : Каталоги оборудования,\nданные о поставках и обслуживании

legend right
  |= Элемент |= Обозначение |
  | Процесс | Овал |
  | Внешняя сущность | Прямоугольник |
  Уровень 0 показывает границу системы: что входит в экосистему
  и с кем она обменивается данными. Декомпозиция — на уровне 1.
endlegend

@enduml
